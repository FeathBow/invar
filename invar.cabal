cabal-version: 3.0
name: invar
version: 0.1.0.0
synopsis: Executable semantic core for inference and reinforcement learning
description: Finite source-checked programs, request and invocation models, and explicit evidence judgements.
license: Apache-2.0
license-file: LICENSE
author: Invar contributors
maintainer: https://github.com/FeathBow/invar/issues
category: AI
build-type: Simple
tested-with: GHC == 9.14.1
extra-doc-files: README.md, docs/design/*.md, docs/backends/*.md, docs/results/*.md, docs/guides/*.md, docs/guides/walkthrough/*.json, docs/guides/walkthrough/basis/*.md, docs/images/*.svg, patches/README.md
extra-source-files: cabal.project, test/types.sh, test/fail.sh, test/accept/*.hs, test/reject/*.hs, test/confidence/*.hs, test/confidence/*.py, patches/vllm/*.patch, patches/vllm/*.sha256, patches/vllm/sources.json

common defaults
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
    base >= 4.22 && < 4.23,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.8 && < 0.9

library
  import: defaults
  build-depends: deepseq >= 1.5 && < 1.6, unix >= 2.8 && < 2.9, process >= 1.6.26 && < 1.7, aeson >= 2.3.1 && < 2.4, text >= 2.1 && < 2.2, directory >= 1.3 && < 1.4, filepath >= 1.5 && < 1.6, cryptohash-sha256 >= 0.11.102.1 && < 0.12
  c-sources: cbits/store.c
  cc-options: -Wall -Wextra -Werror
  default-extensions: NoGeneralizedNewtypeDeriving
  hs-source-dirs: src
  exposed-modules: Invar.Async.Plan, Invar.Async.Core, Invar.Async.Completion, Invar.Async.Entry, Invar.Async.Replay, Invar.Transcript, Invar.Canonical, Invar.Infer.Trajectory, Invar.Infer.Session, Invar.Infer.Replay, Invar.Resident.Owner, Invar.Journal, Invar.Runtime, Invar.Learn.Stream, Invar.Use.Measurement, Invar.Use.Decimal, Invar.Use.Confidence, Invar.Use.Plan, Invar.Use.Prepare, Invar.Use.Execution, Invar.Use.Statistics, Invar.Use, Invar.Score.Worker, Invar.Score, Invar.Numerical, Invar.Spec.Request, Invar.Spec.Value, Invar.Spec.Program, Invar.Spec.Dependency, Invar.Spec.Operator, Invar.Spec.Evaluate, Invar.Spec.Artifact, Invar.Spec.Invocation, Invar.Spec.Evidence, Invar.Spec.Load, Invar.Construct, Invar.Literal, Invar.Store, Invar.Infer, Invar.Infer.Result, Invar.Infer.Observation, Invar.Infer.Invocation, Invar.Worker, Invar.Worker.Resident, Invar.Reward, Invar.Cohort, Invar.Schedule, Invar.Rollout, Invar.Learn, Invar.Learn.Advantage, Invar.Learn.Objective, Invar.Learn.Mismatch, Invar.Learn.Program, Invar.Learn.Wire, Invar.Learn.Protocol, Invar.Learn.Worker, Invar.Learn.Worker.Resident, Invar.Loop, Invar.Policy, Invar.Artifact, Invar.Workload, Invar.Evaluation, Invar.Quality, Invar.Learn.Report, Invar.Learn.Observation, Invar.Learn.State, Invar.History.Cohort, Invar.History.Trace, Invar.History.Generation, Invar.History.Schedule, Invar.History.Runtime, Invar.History.Initial, Invar.History
  other-modules: Invar.Async.Completion.Internal, Invar.Infer.Trajectory.Internal, Invar.Infer.Records, Invar.Learn.Step, Invar.Spec.Measurement, Invar.Spec.Domain, Invar.Use.Encoding, Invar.Use.Contract, Invar.Use.Admission, Invar.Use.Finding, Invar.Numerical.Logarithm, Invar.Spec.UseContract, Invar.Spec.Obligation, Invar.Evidence.Encoding, Invar.Use.Observation, Invar.Spec.Use, Invar.Numerical.Distribution, Invar.Score.Execution, Invar.Score.Probe, Invar.Score.Resources, Invar.Spec.Score, Invar.Infer.Schema, Invar.Score.Program, Invar.Score.Output, Invar.Spec.Numerical, Invar.Quality.Summary, Invar.Reward.Decimal, Invar.Reward.Program, Invar.Materialization, Invar.Load, Invar.Infer.Load, Invar.Infer.Batch, Invar.Infer.Framing, Invar.Spec.Syntax, Invar.Spec.Decode, Invar.Spec.Encode, Invar.Construct.Types, Invar.Infer.Wire, Invar.Infer.Output, Invar.Infer.Model, Invar.Rollout.Internal, Invar.Rollout.Resident, Invar.Process, Invar.Process.Internal, Invar.Process.Resident, Invar.Resident, Invar.Resident.Group, Invar.Policy.Header, Invar.Policy.Description, Invar.Policy.Encoding, Invar.Json, Invar.Learn.Native, Invar.Learn.Observed, Invar.Learn.Codec, Invar.Learn.Adapter, Invar.Learn.Checkpoint, Invar.Learn.Checkpoint.Types, Invar.Learn.Checkpoint.MLX, Invar.Learn.Request, Invar.Learn.Gradient, Invar.Policy.File, Invar.Learn.Probability, Invar.Learn.Fingerprint, Invar.Float32, Invar.Digest, Invar.Learn.Trace, Invar.Learn.Report.Internal, Invar.Async.Recorded, Invar.Learn.Framing, Invar.Learn.Worker.Internal, Invar.Learn.Worker.Observation, Invar.Learn.Worker.Owner, Invar.Loop.Owner, Invar.History.Execution, Invar.History.Profile, Invar.History.Publication, Invar.History.Artifacts, Invar.Measurement.Duration

test-suite request
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: Events, Journals, Replays, Recoveries, Comparisons, Generation, Logs, Evaluations, Traces, Steps, UseBernstein, UsePlan, UsePrepare, UseExecution, UseGeneric, Statistics, UseAdmission, UseEvidence, Uses, UseFixture, NumericalProbes, ScoreProbes, NumericalScores, Scores, Numerical, Model, History, Properties, Fixtures, Arguments, Values, Dependencies, Evaluation, Artifacts, Construction, Collections, Records, Literals, Invocations, Evidence, Loads, Store, Checkpoints, Inference, Results, Calls, BatchCalls, GroupedCalls, BatchedProtocol, ResidentFixture, ResidentCalls, ResidentWorkloads, ResidentDrivers, ResidentObservations, Streams, Rewards, Cohorts, Rollouts, Sessions, Learning, Advantages, Objectives, Mismatches, Updates, LearnerFixture, LearnerCalls, Loops, Schedules, Policies, Probabilities, Workloads, Reports, Quality, Observations, InferenceObservations
  build-depends:
    invar,
    hedgehog >= 1.7 && < 1.8,
    aeson >= 2.3.1 && < 2.4,
    text >= 2.1 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.5 && < 1.6,
    unix >= 2.8 && < 2.9

executable invar
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: Use, UseRuns, UsePlan, UsePrepare, UseExecution, UseInput, UseRun, Check, Located, Envelope, Scoring, Numerical, Options, InferenceInput, EvaluationInput, InferenceBatch, PolicyInput, NativeCodec, HistoryInput, Dataset, Training, Evaluation, Quality, Inspection, Comparison
  build-depends: invar, text >= 2.1 && < 2.2, aeson >= 2.3.1 && < 2.4, cryptohash-sha256 >= 0.11.102.1 && < 0.12, directory >= 1.3 && < 1.4, filepath >= 1.5 && < 1.6, process >= 1.6.26 && < 1.7

source-repository head
  type: git
  location: https://github.com/FeathBow/invar.git
