cabal-version: 3.0
name: invar
version: 0.1.0.0
synopsis: Executable semantic core for inference and reinforcement learning
description: Finite source-checked programs, request and invocation models, and explicit evidence judgements.
license: Apache-2.0
license-file: LICENSE
author: Invar contributors
maintainer: https://github.com/FeathBow/invar/issues
category: AI
build-type: Simple
tested-with: GHC == 9.14.1
extra-source-files: cabal.project, test/types.sh, test/fail.sh, test/accept/*.hs, test/reject/*.hs

common defaults
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
    base >= 4.22 && < 4.23,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.8 && < 0.9

library
  import: defaults
  build-depends: deepseq >= 1.5 && < 1.6
  default-extensions: NoGeneralizedNewtypeDeriving
  hs-source-dirs: src
  exposed-modules: Invar.Spec.Request, Invar.Spec.Value, Invar.Spec.Program, Invar.Spec.Dependency, Invar.Spec.Operator, Invar.Spec.Evaluate, Invar.Spec.Artifact, Invar.Spec.Invocation, Invar.Spec.Evidence, Invar.Spec.Load, Invar.Construct, Invar.Literal
  other-modules: Invar.Spec.Syntax, Invar.Spec.Decode, Invar.Spec.Encode, Invar.Construct.Types

test-suite request
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: Model, History, Properties, Fixtures, Arguments, Values, Dependencies, Evaluation, Artifacts, Construction, Collections, Records, Literals, Invocations, Evidence, Loads
  build-depends:
    invar,
    hedgehog >= 1.7 && < 1.8

source-repository head
  type: git
  location: https://github.com/FeathBow/invar.git
