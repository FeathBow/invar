cabal-version: 3.0
name: invar
version: 0.1.0.0
synopsis: Executable semantic core for inference and reinforcement learning
description: Finite source-checked programs, request and invocation models, and explicit evidence judgements.
license: Apache-2.0
license-file: LICENSE
author: Invar contributors
maintainer: https://github.com/FeathBow/invar/issues
category: AI
build-type: Simple
tested-with: GHC == 9.14.1
extra-source-files: cabal.project, test/types.sh, test/fail.sh, test/accept/*.hs, test/reject/*.hs, test/advantage/*.hs, test/advantage/*.py, test/scalar/*.hs, test/scalar/*.py, patches/vllm/*.patch, patches/vllm/*.sha256

common defaults
  default-language: GHC2021
  ghc-options: -Wall -Wcompat
  build-depends:
    base >= 4.22 && < 4.23,
    bytestring >= 0.12 && < 0.13,
    containers >= 0.8 && < 0.9

library
  import: defaults
  build-depends: deepseq >= 1.5 && < 1.6, unix >= 2.8 && < 2.9, process >= 1.6.26 && < 1.7, aeson >= 2.3.1 && < 2.4, text >= 2.1 && < 2.2, directory >= 1.3 && < 1.4, filepath >= 1.5 && < 1.6, cryptohash-sha256 >= 0.11.102.1 && < 0.12
  c-sources: cbits/store.c
  cc-options: -Wall -Wextra -Werror
  default-extensions: NoGeneralizedNewtypeDeriving
  hs-source-dirs: src
  exposed-modules: Invar.Spec.Request, Invar.Spec.Value, Invar.Spec.Program, Invar.Spec.Dependency, Invar.Spec.Operator, Invar.Spec.Evaluate, Invar.Spec.Artifact, Invar.Spec.Invocation, Invar.Spec.Evidence, Invar.Spec.Load, Invar.Construct, Invar.Literal, Invar.Store, Invar.Infer, Invar.Infer.Result, Invar.Infer.Observation, Invar.Infer.Invocation, Invar.Worker, Invar.Worker.Resident, Invar.Reward, Invar.Cohort, Invar.Schedule, Invar.Rollout, Invar.Learn, Invar.Learn.Advantage, Invar.Learn.Objective, Invar.Learn.Program, Invar.Learn.Wire, Invar.Learn.Protocol, Invar.Learn.Worker, Invar.Learn.Worker.Resident, Invar.Loop, Invar.Policy, Invar.Artifact, Invar.Workload, Invar.Evaluation, Invar.Quality, Invar.Learn.Report, Invar.Learn.Observation, Invar.Learn.State, Invar.History.Cohort, Invar.History.Trace, Invar.History.Initial, Invar.History, Invar.Replay.Inference, Invar.Measurement.Inference, Invar.Measurement, Invar.Replay.Update, Invar.Replay.Update.Output, Invar.Replay.Cycle, Invar.Replay.Native
  other-modules: Invar.Quality.Summary, Invar.Reward.Decimal, Invar.Reward.Program, Invar.Materialization, Invar.Load, Invar.Infer.Load, Invar.Infer.Batch, Invar.Infer.Framing, Invar.Spec.Syntax, Invar.Spec.Decode, Invar.Spec.Encode, Invar.Construct.Types, Invar.Infer.Wire, Invar.Infer.Output, Invar.Infer.Model, Invar.Rollout.Internal, Invar.Rollout.Observation, Invar.Rollout.Resident, Invar.Process, Invar.Process.Internal, Invar.Process.Resident, Invar.Resident, Invar.Resident.Observation, Invar.Resident.Inference, Invar.Policy.Header, Invar.Policy.Description, Invar.Policy.Encoding, Invar.Json, Invar.Learn.Native, Invar.Learn.Observed, Invar.Learn.Codec, Invar.Learn.Adapter, Invar.Learn.Checkpoint, Invar.Learn.Checkpoint.Types, Invar.Learn.Checkpoint.MLX, Invar.Learn.Changes, Invar.Learn.Request, Invar.Learn.Gradient, Invar.Policy.File, Invar.Learn.Probability, Invar.Learn.Trace, Invar.Learn.Framing, Invar.Learn.Worker.Internal, Invar.Learn.Worker.Observation, Invar.Learn.Worker.Owner, Invar.Loop.Owner, Invar.History.Execution, Invar.History.Profile, Invar.History.Publication, Invar.History.Artifacts, Invar.Replay.Call, Invar.Replay.Load, Invar.Replay.Resident, Invar.Measurement.Duration, Invar.Measurement.Stream, Invar.Measurement.Profile, Invar.Measurement.Source, Invar.Measurement.Manifest, Invar.Measurement.Run, Invar.Measurement.Resident, Invar.Measurement.Direct, Invar.Measurement.Direct.Record, Invar.Measurement.Direct.Timing, Invar.Measurement.Direct.Resident, Invar.Measurement.Statistics, Invar.Replay.Update.Artifacts, Invar.Replay.Update.Resident

test-suite request
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  other-modules: Model, History, Properties, Fixtures, Arguments, Values, Dependencies, Evaluation, Artifacts, Construction, Collections, Records, Literals, Invocations, Evidence, Loads, Store, Checkpoints, Inference, Results, Calls, BatchCalls, GroupedCalls, BatchedProtocol, BatchedObservations, ResidentFixture, ResidentCalls, ResidentWorkloads, ResidentDrivers, ResidentObservations, ResidentMeasurements, ResidentReplays, Rewards, Cohorts, Rollouts, Sessions, Learning, Advantages, Objectives, Updates, LearnerFixture, LearnerCalls, Loops, Schedules, Policies, Probabilities, Workloads, Reports, Quality, Observations, InferenceObservations, Measurements
  build-depends:
    invar,
    hedgehog >= 1.7 && < 1.8,
    aeson >= 2.3.1 && < 2.4,
    text >= 2.1 && < 2.2,
    directory >= 1.3 && < 1.4,
    filepath >= 1.5 && < 1.6,
    unix >= 2.8 && < 2.9

executable invar
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  other-modules: CycleReplay, Options, InferenceInput, PolicyInput, NativeCodec, HistoryInput, ReplayInput, UpdateReplayInput, Dataset, Training, Evaluation, Quality, Performance, Inspection, Comparison
  build-depends: invar, text >= 2.1 && < 2.2, aeson >= 2.3.1 && < 2.4, cryptohash-sha256 >= 0.11.102.1 && < 0.12, directory >= 1.3 && < 1.4, filepath >= 1.5 && < 1.6

source-repository head
  type: git
  location: https://github.com/FeathBow/invar.git
