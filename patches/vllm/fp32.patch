 from vllm.triton_utils import tl, triton
 from vllm.utils.torch_utils import direct_register_custom_op
+
+FP32_REDUCTION_COLUMNS = 1024
+FP32_REDUCTION_WARPS = 4
+
+
+@triton.jit
+def _lora_shrink_rows(tensors, layout: tl.constexpr, arithmetic: tl.constexpr):
+    input_ptr, lora_ptr, out_ptr, token_slots = tensors
+    K: tl.constexpr = layout[0]
+    input_row: tl.constexpr = layout[1]
+    input_column: tl.constexpr = layout[2]
+    lora_slot: tl.constexpr = layout[3]
+    lora_rank: tl.constexpr = layout[4]
+    lora_column: tl.constexpr = layout[5]
+    output_row: tl.constexpr = layout[6]
+    output_rank: tl.constexpr = layout[7]
+    slices: tl.constexpr = layout[8]
+    scaling: tl.constexpr = arithmetic[0]
+    BLOCK: tl.constexpr = arithmetic[1]
+    USE_GDC: tl.constexpr = arithmetic[2]
+    rank, row, slice_id = tl.program_id(0), tl.program_id(1), tl.program_id(2)
+    slot = tl.load(token_slots + row)
+    if slot == -1:
+        return
+    if slices == 1:
+        weight = lora_ptr
+    else:
+        weight = tl.load(lora_ptr + slice_id).to(tl.pointer_type(tl.float32))
+    columns = tl.arange(0, BLOCK)
+    accumulator = tl.zeros((BLOCK,), dtype=tl.float32)
+    # Every row uses the same FP32 FMA sequence and reduction tree.
+    for start in range(tl.cdiv(K, BLOCK)):
+        selected = start * BLOCK + columns
+        inputs = tl.load(input_ptr + row * input_row + selected * input_column,
+                         selected < K, 0).to(tl.float32)
+        weights = tl.load(weight + slot * lora_slot + rank * lora_rank + selected * lora_column,
+                          selected < K, 0).to(tl.float32)
+        accumulator = tl.fma(inputs, weights, accumulator)
+    result = tl.sum(accumulator, 0) * scaling
+    if USE_GDC:
+        tl.extra.cuda.gdc_launch_dependents()
+    # Contiguous slice offsets depend on the runtime grid, not specialization.
+    output_slice = tl.num_programs(1) * output_row
+    tl.store(out_ptr + slice_id * output_slice + row * output_row + rank * output_rank, result)
 
 
